# Kernel source and build outputs
/sources/linux-*/
/sources/*.tar
/sources/*.tar.*
/sources/*.xz
/sources/*.gz
/sources/*.sign
/sources/*.deb
/sources/*.buildinfo
/sources/*.changes
/build/

# Binary release artifacts belong in GitHub/GitLab releases
/artifacts/*.deb
/artifacts/*.buildinfo
/artifacts/*.changes

