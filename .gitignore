*.o
*.a
*.s
*.ko
*.ko.*
*.mod
*.mod.c
*.cmd
*.order
Module.symvers
modules.order
.tmp_versions/
.*.cmd

# Editor and OS noise
.DS_Store
*.swp
*.swo
*~

# Local scratch files
/tmp/
/.cache/
